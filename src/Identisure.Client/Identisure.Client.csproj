<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Identisure.Client</PackageId>
    <Version>0.1.0</Version>
    <Authors>Identisure</Authors>
    <Description>C# client for the Identisure REST API</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://developers.identisure.com</PackageProjectUrl>
    <PackageTags>bankid;eid;identity;authentication</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/identisure/api-client-csharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Identisure.Client.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../img/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
